{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist"
  },
  "include": ["server.ts", "app.ts", "config/**/*", "controllers/**/*", "middleware/**/*", "models/**/*", "routes/**/*", "services/**/*", "utils/**/*"]
}
